# Application
PORT=8080
TOKEN_SECRET=secret
TOKEN_EXPIRATION_SECONDS=86400

# Database
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=database
DB_HOST=localhost
DB_PORT=5432

# Goose
GOOSE_MIGRATION_DIR=./db/migrations
GOOSE_DRIVER=postgres
GOOSE_DBSTRING="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"